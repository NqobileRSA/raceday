@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-wrap">
    <div class="auth-side">
        <h2>Every race starts with an entry.</h2>
        <p>Participants enter events and track results. Organisers publish events, manage categories and capture finish times.</p>
    </div>
    <div class="auth-form">
        <div>
            <h1 class="mb-1">Create your account</h1>
            <p class="text-muted mb-4">Already registered? <a asp-action="Login">Log in</a></p>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary-errors" role="alert"></div>

                <fieldset class="mb-4">
                    <legend class="form-label">I want to</legend>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="role-option">
                                <input type="radio" asp-for="Role" value="Participant">
                                <span class="rd-card d-block"><strong class="d-block"><i class="bi bi-stopwatch me-1"></i>Take part</strong><small class="text-muted">Enter events and track results</small></span>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="role-option">
                                <input type="radio" asp-for="Role" value="Organiser">
                                <span class="rd-card d-block"><strong class="d-block"><i class="bi bi-flag me-1"></i>Organise</strong><small class="text-muted">Publish and run events</small></span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Role" class="field-validation-error"></span>
                </fieldset>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name">
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name">
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email">
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="pw-help">
                        <div id="pw-help" class="form-text">8+ characters with a letter and a number.</div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")">
                        <div class="form-text">Used to check age categories.</div>
                        <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Prefer not to say</option>
                            @foreach (var g in Choices.Genders) { <option value="@g">@g</option> }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel">
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Province" class="form-label"></label>
                        <select asp-for="Province" class="form-select">
                            <option value="">Choose a province</option>
                            @foreach (var p in Choices.Provinces) { <option value="@p">@p</option> }
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 mt-4">Create account</button>
            </form>
        </div>
    </div>
</div>
