@{
    ViewData["Title"] = "No access";
    var user = Context.Session.CurrentUser();
}
<div class="container rd-section">
    <div class="rd-card empty mx-auto" style="max-width:560px">
        <i class="bi bi-sign-stop"></i>
        <h1 class="h2">That page isn't for your account</h1>
        <p class="text-muted">You're logged in as @(user?.Role ?? "a guest"). This page belongs to the other role.</p>
        @if (user?.IsOrganiser == true)
        {
            <a class="btn btn-primary" asp-controller="Organiser" asp-action="Dashboard">Go to your dashboard</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Find events</a>
        }
    </div>
</div>
