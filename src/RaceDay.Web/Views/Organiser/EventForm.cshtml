@model EventFormViewModel
@{
    var editing = Model.EventId is not null;
    ViewData["Title"] = editing ? "Edit event" : "Create event";
}
<div class="container">
    <div class="page-head">
        <h1>@(editing ? $"Edit {Model.Title}" : "Create an event")</h1>
        <p>@(editing ? "Changes show on the event page straight away." : "Publish it now or save it as a draft. You'll add categories next.")</p>
    </div>
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="CurrentImageUrl" />
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="rd-card p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary-errors" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Soweto Freedom Run">
                            <span asp-validation-for="Title" class="field-validation-error"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="What makes this event special: route highlights, water points, race-day atmosphere."></textarea>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="date">
                            <span asp-validation-for="EventDate" class="field-validation-error"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" max="999.99" placeholder="e.g. 21.1">
                            <span asp-validation-for="DistanceKm" class="field-validation-error"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="Start venue and town">
                            <span asp-validation-for="Location" class="field-validation-error"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Province" class="form-label"></label>
                            <select asp-for="Province" class="form-select">
                                <option value="">Choose a province</option>
                                @foreach (var p in Choices.Provinces) { <option value="@p">@p</option> }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                @foreach (var t in Choices.EventTypes) { <option value="@t">@t</option> }
                            </select>
                            <span asp-validation-for="EventType" class="field-validation-error"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var s in Choices.EventStatuses) { <option value="@s">@s</option> }
                            </select>
                            <div class="form-text">Only Published events appear on the home page.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="ContactEmail" class="form-label"></label>
                            <input asp-for="ContactEmail" class="form-control" type="email" placeholder="entries@yourevent.co.za">
                            <span asp-validation-for="ContactEmail" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="rd-card p-4">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                    {
                        <img id="banner-preview" class="upload-preview mb-2" src="@Model.CurrentImageUrl" alt="Current banner">
                    }
                    else
                    {
                        <img id="banner-preview" class="upload-preview mb-2" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="">
                    }
                    <input asp-for="Banner" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" data-preview="banner-preview">
                    <div class="form-text">JPG, PNG or WebP up to 5 MB, ideally 1600 by 700. Uploaded to Azure Blob Storage through the API.</div>
                </div>
                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-primary py-2">@(editing ? "Save changes" : "Create event")</button>
                    <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>
