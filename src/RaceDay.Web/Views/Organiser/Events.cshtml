@model List<EventDto>
@{
    ViewData["Title"] = "My events";
    var status = ViewBag.Status as string;
}
<div class="container">
    <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1>My events</h1>
            <p>Edit details and banners, manage categories, confirm entries and capture results.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Create event</a>
    </div>

    <nav class="d-flex gap-2 flex-wrap mb-3" aria-label="Filter by status">
        <a class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-dark" : "btn-outline-secondary")" asp-action="Events">All</a>
        @foreach (var s in Choices.EventStatuses)
        {
            <a class="btn btn-sm @(status == s ? "btn-dark" : "btn-outline-secondary")" asp-action="Events" asp-route-status="@s">@s</a>
        }
    </nav>

    @if (Model.Count == 0)
    {
        <div class="rd-card empty">
            <i class="bi bi-calendar-plus"></i>
            <h3>No events here yet</h3>
            <p class="text-muted">Create your first event to start taking entries.</p>
            <a class="btn btn-primary" asp-action="Create">Create event</a>
        </div>
    }
    else
    {
        <div class="rd-card overflow-hidden">
            <div class="table-responsive">
                <table class="table rd-table">
                    <thead><tr><th style="width:90px"></th><th>Event</th><th>Date</th><th>Distance</th><th>Entries</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td><div class="event-banner rounded" style="width:80px"><partial name="_Banner" model="e" /></div></td>
                                <td><a class="fw-semibold text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.Title</a><div class="small text-muted">@e.EventType, @e.Location</div></td>
                                <td class="text-nowrap">@e.EventDate.ToString("d MMM yyyy")</td>
                                <td class="tabular">@e.DistanceLabel</td>
                                <td class="time-cell">@e.EnrolmentCount</td>
                                <td><partial name="_Status" model="e.Status" /></td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">Manage</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" asp-action="Categories" asp-route-id="@e.EventId"><i class="bi bi-list-ol me-2"></i>Categories</a></li>
                                            <li><a class="dropdown-item" asp-action="Enrolments" asp-route-id="@e.EventId"><i class="bi bi-people me-2"></i>Enrolments</a></li>
                                            <li><a class="dropdown-item" asp-action="Results" asp-route-id="@e.EventId"><i class="bi bi-stopwatch me-2"></i>Results</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="m-0" data-confirm="Delete @e.Title? Its categories, entries and results will be removed too.">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete event</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
