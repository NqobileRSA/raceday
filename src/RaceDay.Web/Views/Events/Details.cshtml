@model EventDetailsViewModel
@{
    var ev = Model.Event;
    var user = Context.Session.CurrentUser();
    ViewData["Title"] = ev.Title;
    var isOwner = user?.IsOrganiser == true && user.Id == ev.OrganiserId;
    var canEnter = ev.IsUpcoming && ev.Status == "Published";
}
<section class="detail-hero">
    <partial name="_Banner" model="ev" />
    <div class="overlay"></div>
    <div class="container">
        <div class="d-flex gap-2 flex-wrap">
            <span class="chip">@ev.EventType</span>
            <span class="chip chip-gold tabular">@ev.DistanceLabel</span>
            @if (ev.Status != "Published") { <partial name="_Status" model="ev.Status" /> }
        </div>
        <h1>@ev.Title</h1>
    </div>
</section>

<div class="container rd-section">
    <div class="row g-4">
        <div class="col-lg-8">
            @if (!string.IsNullOrEmpty(ev.Description))
            {
                <h2 class="h3">About the event</h2>
                <p style="max-width:70ch">@ev.Description</p>
            }

            <h2 class="h3 mt-4" id="categories">Categories</h2>
            @if (ev.Categories.Count == 0)
            {
                <p class="text-muted">The organiser hasn't added categories yet.</p>
            }
            else
            {
                <div class="rd-card overflow-hidden">
                    <div class="table-responsive">
                        <table class="table rd-table">
                            <thead><tr><th>Category</th><th>Distance</th><th>Ages</th><th>Entry fee</th><th>Spots left</th></tr></thead>
                            <tbody>
                                @foreach (var c in ev.Categories)
                                {
                                    <tr>
                                        <td class="fw-semibold">@c.Name @if (c.GenderRestriction is not null) { <span class="chip chip-dark ms-1">@c.GenderRestriction only</span> }</td>
                                        <td class="tabular">@c.DistanceKm.ToString("0.#")km</td>
                                        <td>@c.AgeLabel</td>
                                        <td class="tabular">@(c.EntryFee == 0 ? "Free" : c.EntryFee.ToString("R 0.00"))</td>
                                        <td class="tabular">@(c.SpotsRemaining?.ToString() ?? "Open") @if (c.IsFull) { <span class="status status-cancelled ms-1">Full</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (ev.Route is { } route && !string.IsNullOrEmpty(route.Description))
            {
                <h2 class="h3 mt-4">The route</h2>
                <p style="max-width:70ch">@route.Description</p>
                <div class="d-flex gap-2 flex-wrap">
                    @if (route.ElevationGainM is { } gain) { <span class="chip chip-dark"><i class="bi bi-graph-up-arrow"></i>@gain m climbing</span> }
                    @if (!string.IsNullOrEmpty(route.TerrainType)) { <span class="chip chip-dark"><i class="bi bi-signpost"></i>@route.TerrainType</span> }
                </div>
            }

            @if (ev.Announcements.Count > 0)
            {
                <h2 class="h3 mt-4">Announcements</h2>
                @foreach (var a in ev.Announcements)
                {
                    <div class="rd-card p-3 mb-2">
                        <div class="d-flex justify-content-between gap-2"><strong>@a.Title</strong><small class="text-muted">@a.CreatedAt.ToString("d MMM yyyy")</small></div>
                        <p class="mb-0 mt-1">@a.Message</p>
                    </div>
                }
            }
        </div>

        <aside class="col-lg-4">
            <div class="sticky-panel d-flex flex-column gap-3">
                <div class="rd-card p-4">
                    <dl class="facts mb-0">
                        <dt>Date</dt><dd class="fs-5 fw-semibold">@ev.EventDate.ToString("dddd, d MMMM yyyy")</dd>
                        <dt>Start</dt><dd>@ev.Location@(string.IsNullOrEmpty(ev.Province) ? "" : $", {ev.Province}")</dd>
                        <dt>Organiser</dt><dd>@ev.OrganiserName</dd>
                        @if (!string.IsNullOrEmpty(ev.ContactEmail)) { <dt>Contact</dt><dd><a href="mailto:@ev.ContactEmail">@ev.ContactEmail</a></dd> }
                        <dt>Entries so far</dt><dd class="mb-0 tabular">@ev.EnrolmentCount</dd>
                    </dl>
                    @if (Model.Weather is { } w)
                    {
                        <div class="mt-3 pt-3 border-top d-flex align-items-center gap-3">
                            <i class="bi bi-cloud-sun fs-2 text-warning"></i>
                            <div><div class="fw-semibold">@w.TemperatureC.ToString("0")°C, @w.Conditions</div><small class="text-muted">Now at the start line. Wind @w.WindSpeedKmh.ToString("0") km/h</small></div>
                        </div>
                    }
                </div>

                @if (isOwner)
                {
                    <div class="rd-card p-4">
                        <h2 class="h4">Manage this event</h2>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="Organiser" asp-action="Edit" asp-route-id="@ev.EventId">Edit event and banner</a>
                            <a class="btn btn-outline-secondary" asp-controller="Organiser" asp-action="Categories" asp-route-id="@ev.EventId">Categories</a>
                            <a class="btn btn-outline-secondary" asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@ev.EventId">Enrolments</a>
                            <a class="btn btn-outline-secondary" asp-controller="Organiser" asp-action="Results" asp-route-id="@ev.EventId">Results</a>
                        </div>
                    </div>
                }
                else if (Model.MyEnrolment is { } mine)
                {
                    <div class="rd-card p-4">
                        <h2 class="h4">You're entered</h2>
                        <p class="mb-2">@mine.CategoryName</p>
                        <partial name="_Status" model="mine.Status" />
                        @if (!string.IsNullOrEmpty(mine.BibNumber)) { <p class="mt-2 mb-0">Bib <strong class="tabular">@mine.BibNumber</strong></p> }
                        <a class="btn btn-outline-secondary w-100 mt-3" asp-controller="Participant" asp-action="MyEvents">View my events</a>
                    </div>
                }
                else if (!canEnter)
                {
                    <div class="rd-card p-4">
                        <h2 class="h4">Entries closed</h2>
                        <p class="text-muted mb-0">This event isn't taking entries.@(ev.IsUpcoming ? "" : " Results are on each participant's My results page.")</p>
                    </div>
                }
                else if (user is null)
                {
                    <div class="rd-card p-4">
                        <h2 class="h4">Enter this event</h2>
                        <p class="text-muted">Log in or create a participant account to choose your category.</p>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Events/Details/{ev.EventId}")">Log in to enter</a>
                            <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Register">Create an account</a>
                        </div>
                    </div>
                }
                else if (user.IsParticipant)
                {
                    <form class="rd-card p-4" asp-action="Enrol" asp-route-id="@ev.EventId" method="post">
                        <h2 class="h4">Enter this event</h2>
                        @if (ev.Categories.Count == 0)
                        {
                            <p class="text-muted mb-0">Entries open once the organiser adds categories.</p>
                        }
                        else
                        {
                            <fieldset class="mb-3">
                                <legend class="form-label">Choose your category</legend>
                                @foreach (var c in ev.Categories)
                                {
                                    <label class="category-option @(c.IsFull ? "disabled" : "")">
                                        <input type="radio" name="CategoryId" value="@c.CategoryId" class="form-check-input mt-0" disabled="@c.IsFull" required>
                                        <span class="flex-fill"><span class="fw-semibold d-block">@c.Name</span><small class="text-muted">@c.AgeLabel, @(c.EntryFee == 0 ? "Free" : c.EntryFee.ToString("R 0"))</small></span>
                                        <span class="tabular fw-semibold">@c.DistanceKm.ToString("0.#")km</span>
                                    </label>
                                }
                            </fieldset>
                            <div class="mb-2">
                                <label class="form-label" for="ecn">Emergency contact name</label>
                                <input class="form-control" id="ecn" name="EmergencyContactName" maxlength="100" autocomplete="off">
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="ecp">Emergency contact phone</label>
                                <input class="form-control" id="ecp" name="EmergencyContactPhone" maxlength="20" type="tel" autocomplete="off">
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">Enter event</button>
                            <p class="small text-muted mt-2 mb-0">Your entry is saved straight away and confirmed by the organiser.</p>
                        }
                    </form>
                }
            </div>
        </aside>
    </div>
</div>
