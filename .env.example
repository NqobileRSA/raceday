# Copy to .env to store images in a real Azure Storage account instead of Azurite.
# Azure portal > Storage account > Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOURACCOUNT;AccountKey=YOURKEY;EndpointSuffix=core.windows.net
# Leave empty for real Azure (links point straight at the account)
AZURE_PUBLIC_BLOB_ENDPOINT=
